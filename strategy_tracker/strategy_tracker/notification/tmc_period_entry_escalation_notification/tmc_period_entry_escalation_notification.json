 "message": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>KPI Period Entry Escalation - {{ doc.name }}</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            background-color: #f4f4f4;\n            margin: 0;\n            padding: 0;\n        }\n        .container {\n            width: 100%;\n            max-width: 700px;\n            margin: 0 auto;\n            background-color: #ffffff;\n            padding: 20px;\n            border-radius: 8px;\n            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);\n        }\n        h2 {\n            color: #333333;\n            font-size: 20px;\n            margin-bottom: 15px;\n        }\n        p {\n            color: #555555;\n            line-height: 1.6;\n            font-size: 14px;\n        }\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            margin: 20px 0;\n        }\n        table th {\n            background-color: #dc3545;\n            color: #ffffff;\n            padding: 10px;\n            text-align: left;\n            font-size: 14px;\n        }\n        table td {\n            border: 1px solid #dddddd;\n            padding: 10px;\n            font-size: 13px;\n        }\n        .cta {\n            background-color: #fff3cd;\n            border-left: 4px solid #ffc107;\n            padding: 15px;\n            margin-top: 20px;\n            color: #664d03;\n        }\n        .footer {\n            font-size: 12px;\n            color: #888888;\n            text-align: center;\n            margin-top: 30px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n\n        <p>\n            Dear TMC Member,\n        </p>\n\n        <p>\n            A KPI Period Entry has been <strong>escalated</strong> following completion of the review process due to one or more KPIs being assessed as <strong>Red</strong>.\n        </p>\n\n        <p>\n            <strong>Function Head:</strong> {{ doc.head_of_function_name }}<br>\n            <strong>KPI Period Entry:</strong> {{ doc.name }}<br>\n            <strong>Overall Status:</strong> {{ doc.overall_rag }}\n        </p>\n\n        {% set red_kpis = doc.kpi_reviews | selectattr(\"rag_status\", \"equalto\", \"Red\") | list %}\n\n        {% if red_kpis %}\n        <p>The following KPI(s) require management attention:</p>\n        \n        <table>\n            <thead>\n                <tr>\n                    <th>KPI</th>\n                    <th>Actual Performance</th>\n                    <th>Target</th>\n                    <th>Action Plan</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for row in red_kpis %}\n                <tr>\n                    <td>{{ row.kpi_description }}</td>\n                    <td>{{ row.actual_performance }}</td>\n                    <td>{{ row.target }}</td>\n                    <td>{{ row.corrective_action_summary }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        {% endif %}\n        \n        <br>\n\n        <div class=\"cta\">\n            <strong>Action Required</strong><br>\n            Please review the escalated KPI Period Entry and the affected KPI(s). Where necessary, provide strategic guidance, approve corrective interventions, or engage the responsible Function Head to ensure appropriate recovery actions are implemented.\n        </div>\n\n        <p>\n            You can review the complete KPI Period Entry using the link below:\n        </p>\n\n        <p>\n            <a href=\"{{ frappe.utils.get_url() }}/app/{{ doc.doctype.replace(' ', '-') | lower }}/{{ doc.name }}\">\n                Open KPI Period Entry\n            </a>\n        </p>\n\n        <p>\n            Best Regards,<br>\n            Strategy Execution Tracking System</p>\n        </p>\n\n        <div class=\"footer\">\n            <p>This is an automated message. Please do not reply to this email.</p>\n        </div>\n\n    </div>\n</body>\n</html>",
